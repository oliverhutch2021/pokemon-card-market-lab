#!/bin/sh
# check the full tree and history of every ref being pushed
PY=$(command -v python3 || command -v python || command -v py) || { echo "guard: no python found, push blocked"; exit 1; }
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  "$PY" "$(git rev-parse --show-toplevel)/tools/guard.py" tree "$local_sha" || exit 1
done
